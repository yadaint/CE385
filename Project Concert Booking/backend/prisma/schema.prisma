// Concert Ticket Booking System — Database Schema
// Run: npm run prisma:migrate (or: npx prisma migrate dev --name init)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  PENDING_VERIFICATION
  COMPLETED
  REJECTED
  CANCELLED
}

/// สถานะการตรวจสอบสลิปการชำระเงิน
enum PaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

/// ตำแหน่งของโซนบนผัง: ซ้าย / กลาง / ขวา (เมื่อมองจากผู้ชมหันหน้าเข้าหาเวที)
enum ZoneSide {
  LEFT
  CENTER
  RIGHT
}

/// ต้นสังกัดคอนเสิร์ต: ไทย / ต่างประเทศ
enum Origin {
  THAI
  INTERNATIONAL
}

/// รูปแบบการแสดง: คอนเดี่ยว / คอนกลุ่ม
enum ArtistType {
  SOLO
  GROUP
}

/// สถานะการเปิดขายบัตรของคอนเสิร์ต
/// DRAFT    = สร้างไว้แต่ยังไม่เปิดขาย (ผู้ใช้ทั่วไปยังไม่เห็นหน้าจอง)
/// OPEN     = เปิดขายแล้ว (แสดงบนหน้าจอง)
/// CLOSED   = แอดมินปิดขายชั่วคราว หรือหมดเวลาขายตามวันสุดท้ายที่กำหนด
/// SOLD_OUT = บัตรทุกโซนที่เปิดขายหมดแล้ว (ตั้งโดยระบบอัตโนมัติ)
/// CANCELLED = ยกเลิกการขายถาวร (ป้องกันปัญหาระหว่างเปิดขาย — แก้ไขข้อมูลไม่ได้อีก)
enum ConcertSaleStatus {
  DRAFT
  OPEN
  CLOSED
  SOLD_OUT
  CANCELLED
}

/// ประเภทการแจ้งเตือนหลังบ้าน
enum NotificationType {
  ZONE_SOLD_OUT
  CONCERT_SOLD_OUT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ข้อมูลผู้สมัคร (กรอกตอนสมัครสมาชิก — ใช้ยืนยันตัวตนด้วยการกรอกข้อมูล)
  firstName        String?
  lastName         String?
  phone            String?
  dateOfBirth      DateTime?
  /// เลขบัตรประชาชน 13 หลัก (ตรวจ checksum ก่อนบันทึก)
  nationalId       String?
  /// เลขหลังบัตรประชาชน (Laser code ด้านหลังบัตร)
  nationalIdBack   String?

  bookings         Booking[]
  reviewedPayments Payment[] @relation("ReviewedPayments")
}

model Concert {
  id          String     @id @default(cuid())
  name        String
  /// ชื่อคอนเสิร์ตภาษาอังกฤษ (ถ้าว่าง ระบบจะใช้ชื่อภาษาไทยแสดงทั้งสองภาษา)
  nameEn      String?
  description String
  /// วันที่แสดงทั้งหมด — คอนเสิร์ตหนึ่งงานจัดได้หลายวัน
  dates       DateTime[]
  venueId     String
  origin      Origin     @default(THAI)
  artistType  ArtistType @default(GROUP)
  /// URL รูปภาพปก (ถ้ามี) — ถ้าไม่มีจะแสดงอิโมจิประจำคอนเสิร์ตบน gradient เฉพาะ
  imageUrl    String?
  /// อิโมจิประจำคอนเสิร์ต ใช้บนการ์ดเมื่อไม่มีรูปภาพ
  emoji       String?
  /// สถานะการเปิดขายบัตร — สร้างใหม่เป็น DRAFT เสมอ แอดมินต้องกด "เปิดขาย" เอง
  saleStatus  ConcertSaleStatus @default(DRAFT)
  /// วันและเวลาสุดท้ายของการขายบัตร — ถึงเวลาระบบจะปิดขายอัตโนมัติ (null = ไม่จำกัด)
  saleEndDate DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  venue         Venue          @relation(fields: [venueId], references: [id])
  zones         Zone[]
  bookings      Booking[]
  notifications Notification[]
}

/// สถานที่จัดคอนเสิร์ต — ผังโซนที่นั่ง FIX ประจำสถานที่
/// แต่ละสถานที่มีผัง (โซน/รหัส/ตำแหน่ง/จำนวนที่นั่ง) ที่ตายตัวของสถานที่นั้นๆ
model Venue {
  id       String      @id @default(cuid())
  name     String      @unique
  concerts Concert[]
  zones    VenueZone[]
}

/// ผังโซนประจำสถานที่ — โซนไหนอยู่แถวไหน ฝั่งไหน กี่แถว แถวละกี่ที่นั่ง
model VenueZone {
  id          String   @id @default(cuid())
  venueId     String
  name        String
  /// รหัสโซน 2 ตัวอักษร ใช้สร้างรหัสตั๋ว เช่น GD (โกลด์)
  code        String
  side        ZoneSide @default(CENTER)
  wide        Boolean  @default(false)
  mapRow      Int
  rowCount    Int
  seatsPerRow Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

/// A priced seating zone of a concert (e.g. VIP, Gold, Standing),
/// each with its own seat pool. `sortOrder` = row position on the
/// seating map (1 = closest to the stage).
model Zone {
  id             String   @id @default(cuid())
  concertId      String
  name           String
  price          Float
  totalSeats     Int
  availableSeats Int
  sortOrder      Int
  /// ตำแหน่งซ้าย/กลาง/ขวาบนผัง
  side           ZoneSide @default(CENTER)
  /// โซนกว้างครอบเต็มความกว้างแถวบนผัง (เช่น โซนยืน)
  wide           Boolean  @default(false)
  /// รหัสโซน 2 ตัวอักษร ใช้สร้างรหัสตั๋ว เช่น GD (โกลด์)
  code           String
  /// โซนนี้เปิดขายหรือไม่ (โซนปิดขายจะเป็นสีเทา เลือกไม่ได้)
  isOnSale       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  concert     Concert   @relation(fields: [concertId], references: [id], onDelete: Cascade)
  seats        Seat[]
  bookings     Booking[]
  notifications Notification[]

  @@index([concertId])
}

/// การแจ้งเตือนหลังบ้าน เช่น บัตรโซนไหนหมด / บัตรทั้งคอนเสิร์ตหมด
/// สร้างอัตโนมัติโดยระบบเมื่อ availableSeats ของโซนถึง 0
model Notification {
  id        String          @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  concertId String?
  zoneId    String?
  /// แอดมินอ่านแล้วหรือยัง (ใช้นับ "ยังไม่อ่าน" บนหน้าหลังบ้าน)
  isRead    Boolean         @default(false)
  createdAt DateTime        @default(now())

  concert Concert? @relation(fields: [concertId], references: [id], onDelete: Cascade)
  zone    Zone?    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@index([createdAt])
}

/// An individual physical seat inside a zone (row + number, e.g. A12).
/// `isAvailable` is maintained transactionally together with the zone's
/// `availableSeats` counter when bookings are created or cancelled.
model Seat {
  id          String   @id @default(cuid())
  zoneId      String
  rowLabel    String
  seatNumber  Int
  code        String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zone         Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([zoneId, code])
  @@index([zoneId])
}

/// Join table: which specific seats are held by which booking.
/// ticketCode = รหัสตั๋วประจำที่นั่ง (1 ที่นั่ง = 1 บัตร 10 ตัวอักษร)
model BookingSeat {
  bookingId  String
  seatId     String
  ticketCode String? @unique

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([bookingId, seatId])
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  concertId  String
  zoneId     String
  quantity   Int
  totalPrice Float
  /// วันที่แสดงที่ผู้ใช้เลือกจอง
  showDate   DateTime
  /// รหัสตั๋ว 10 ตัว: PJY (3 ตัวแรก) + รหัสโซน (2 ตัว) + เลขสุ่ม (5 ตัว)
  ticketCode String @unique
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  seats   BookingSeat[]
  payment Payment?

  @@index([userId])
  @@index([concertId])
  @@index([zoneId])
}

/// สลิปการชำระเงินของการจอง (1 การจองมีสลิปล่าสุดได้ 1 รายการ)
model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  slipImage  String
  status     PaymentStatus @default(PENDING_VERIFICATION)
  /// หมายเหตุจากแอดมิน (เช่น เหตุผลที่ปฏิเสธสลิป)
  note       String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewedPayments", fields: [reviewedBy], references: [id])

  @@index([status])
}
