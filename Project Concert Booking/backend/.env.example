# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── PostgreSQL ───────────────────────────────────────────
# Adjust user/password/host to match your local PostgreSQL setup.
# Tip (Docker): docker run --name concert-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=concert_booking -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/concert_booking?schema=public"

# ─── Authentication ───────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN_SECONDS=86400

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
